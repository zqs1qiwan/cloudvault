{
  "name": "cloudvault",
  "version": "1.14.6",
  "license": "MIT",
  "description": "Open-source private cloud storage for Cloudflare Workers + R2",
  "keywords": [
    "cloudflare",
    "cloudflare-workers",
    "r2",
    "webdav",
    "cloud-storage",
    "self-hosted",
    "open-source"
  ],
  "homepage": "https://github.com/zqs1qiwan/cloudvault#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zqs1qiwan/cloudvault.git"
  },
  "bugs": {
    "url": "https://github.com/zqs1qiwan/cloudvault/issues"
  },
  "cloudflare": {
    "bindings": {
      "VAULT_KV": {
        "description": "KV namespace for accounts, sessions, share links and site settings. Cloudflare creates it during one-click deploy."
      },
      "VAULT_BUCKET": {
        "description": "R2 bucket for file content. Cloudflare creates it during one-click deploy."
      }
    }
  },
  "scripts": {
    "build:css": "tailwindcss -i ./tailwind.css -o ./public/css/tailwind.css --minify",
    "predeploy": "npm run build:css",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test",
    "types": "wrangler types",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.0"
  }
}
